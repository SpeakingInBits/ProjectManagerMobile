// Design tokens and shared controls, mirroring the web app's style.css tokens.

import { Palette } from "std-widgets.slint";

export global Theme {
    // 0 = follow the system, 1 = light, 2 = dark.
    in-out property <int> mode: 0;
    out property <bool> dark: mode == 2 || (mode == 0 && Palette.color-scheme == ColorScheme.dark);

    out property <color> bg: dark ? #111318 : #f7f8fa;
    out property <color> surface: dark ? #1b1d23 : #ffffff;
    out property <color> surface-raised: dark ? #23262d : #ffffff;
    out property <color> border: dark ? #30333b : #e2e5ea;
    out property <color> text: dark ? #eef0f4 : #1f2430;
    out property <color> text-muted: dark ? #a2a7b3 : #6b7280;
    out property <color> primary: dark ? #6d9bff : #2563eb;
    out property <color> primary-text: dark ? #0b0e14 : #ffffff;
    out property <color> primary-soft: dark ? #1b2a47 : #eff6ff;
    out property <color> primary-soft-border: dark ? #2c4a7c : #bfdbfe;
    out property <color> success: dark ? #3ecf8e : #16a34a;
    out property <color> danger: dark ? #f07272 : #dc2626;
    out property <color> overdue-bg: dark ? #3a1d20 : #fef2f2;
    out property <color> overdue-text: dark ? #f59a9a : #b91c1c;
    out property <color> warning-bg: dark ? #3a2e12 : #fef3c7;
    out property <color> warning-border: dark ? #b7791f : #f59e0b;
    out property <color> warning-text: dark ? #f5d08a : #92400e;
    out property <color> badge-bg: dark ? #2a2d35 : #f1f3f6;
    out property <color> overlay: dark ? #00000099 : #00000066;

    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 24px;

    out property <length> font-sm: 13px;
    out property <length> font-base: 16px;
    out property <length> font-md: 18px;
    out property <length> font-lg: 22px;

    out property <length> radius-sm: 6px;
    out property <length> radius-md: 12px;
    out property <length> tap: 44px;
}

// Stroke icons on a 24x24 grid.
export global Icons {
    out property <string> folder: "M3 7a2 2 0 0 1 2 -2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z";
    out property <string> tasks: "M9 11l3 3 8-8 M20 12v6a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h9";
    out property <string> clock: "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M12 7v5l3 2";
    out property <string> tag: "M20 12.5 12.5 20 4 11.5V4h7.5z M7 8.5a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0";
    out property <string> plus: "M12 5v14M5 12h14";
    out property <string> minus: "M5 12h14";
    out property <string> check: "M5 12.5l4.5 4.5 9.5-10";
    out property <string> edit: "M4 16.5V20h3.5L18 9.5 14.5 6z";
    out property <string> trash: "M5 7h14M9 7V4h6v3M7 7l1 13h8l1-13";
    out property <string> close: "M6 6l12 12M18 6 6 18";
    out property <string> pin: "M9 4h6 M10 4v5l-3 4h10l-3 -4v-5 M12 13v7";
    out property <string> history: "M3.5 12a8.5 8.5 0 1 0 2.5 -6 M3 4v4.5h4.5 M12 8v4l3 2";
    out property <string> note: "M6 3h9l4 4v14h-13z M14 3v5h5 M9 13h6 M9 17h6";
    out property <string> sliders: "M4 7h8M16 7h4M4 17h4M12 17h8 M12 7a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M8 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0";
    out property <string> sun: "M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0 M12 2v3M12 19v3M4 12H1M23 12h-3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2";
    out property <string> moon: "M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z";
    out property <string> auto: "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M12 3v18";
    out property <string> chevron-right: "m9 6 6 6-6 6";
    out property <string> chevron-left: "m15 6 -6 6 6 6";
    out property <string> chevron-down: "m6 9 6 6 6-6";
    out property <string> arrow-up: "M12 19V5M5 12l7-7 7 7";
    out property <string> arrow-down: "M12 5v14M5 12l7 7 7-7";
    out property <string> calendar: "M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2z M3 10h18 M8 3v4 M16 3v4";
}

export component Icon inherits Path {
    in property <string> icon;
    in property <color> color: Theme.text;
    width: 20px;
    height: 20px;
    commands: icon;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

export component Card inherits Rectangle {
    in property <length> pad: Theme.space-4;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-md;
    VerticalLayout {
        padding: root.pad;
        spacing: Theme.space-3;
        @children
    }
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> secondary;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();
    // Sized to its label unless a caller stretches it.
    horizontal-stretch: 0;
    height: Theme.tap;
    border-radius: Theme.radius-md;
    background: secondary ? Theme.surface : danger ? Theme.danger : Theme.primary;
    border-width: secondary ? 1px : 0px;
    border-color: Theme.border;
    opacity: enabled ? (touch.pressed ? 0.8 : 1) : 0.5;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { touch.clicked(); }
    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-2;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            color: root.secondary ? Theme.text : Theme.primary-text;
            width: 18px;
            height: 18px;
        }
        Text {
            text: root.text;
            font-size: Theme.font-base;
            font-weight: 600;
            color: root.secondary ? Theme.text : Theme.primary-text;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> icon-color: Theme.text-muted;
    in property <length> icon-size: 18px;
    callback clicked();
    width: Theme.tap;
    height: Theme.tap;
    border-radius: Theme.radius-sm;
    background: touch.pressed ? Theme.bg : transparent;
    opacity: enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { touch.clicked(); }
    Icon {
        icon: root.icon;
        color: root.icon-color;
        width: root.icon-size;
        height: root.icon-size;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A row of mutually exclusive choices, like the web app's segmented controls / type toggles.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback changed(int);
    height: Theme.tap;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    HorizontalLayout {
        for option[i] in root.options: Rectangle {
            horizontal-stretch: 1;
            background: i == root.selected ? Theme.primary : transparent;
            accessible-role: button;
            accessible-label: option;
            accessible-checked: i == root.selected;
            Text {
                text: option;
                font-size: Theme.font-sm + 1px;
                font-weight: 600;
                color: i == root.selected ? Theme.primary-text : Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea {
                clicked => {
                    root.selected = i;
                    root.changed(i);
                }
            }
        }
    }
}

export component FieldLabel inherits Text {
    font-size: Theme.font-sm;
    color: Theme.text-muted;
}

// Labeled single-line text input.
export component TextField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <string> prefix;
    in property <InputType> input-type: InputType.text;
    in property <bool> invalid;
    in-out property <string> text <=> input.text;
    callback edited(string);
    callback accepted();
    spacing: Theme.space-1;
    if root.label != "": FieldLabel { text: root.label; }
    Rectangle {
        height: Theme.tap;
        border-radius: Theme.radius-sm;
        border-width: input.has-focus || root.invalid ? 2px : 1px;
        border-color: input.has-focus ? Theme.primary : root.invalid ? Theme.danger : Theme.border;
        background: Theme.surface;
        HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-3;
            spacing: Theme.space-1;
            if root.prefix != "": Text {
                horizontal-stretch: 0;
                text: root.prefix;
                color: Theme.text-muted;
                font-size: Theme.font-base;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
                input := TextInput {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    color: Theme.text;
                    font-size: Theme.font-base;
                    vertical-alignment: center;
                    single-line: true;
                    input-type: root.input-type;
                    selection-background-color: Theme.primary.with-alpha(0.3);
                    accessible-label: root.label;
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(); }
                }
                if input.text == "": Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: root.placeholder;
                    color: Theme.text-muted.with-alpha(0.7);
                    font-size: Theme.font-base;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
            }
        }
    }
}

// Labeled multi-line text input.
export component TextArea inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text <=> input.text;
    spacing: Theme.space-1;
    FieldLabel { text: root.label; }
    Rectangle {
        height: 80px;
        border-radius: Theme.radius-sm;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.primary : Theme.border;
        background: Theme.surface;
        clip: true;
        input := TextInput {
            x: Theme.space-3;
            y: Theme.space-2;
            width: parent.width - 2 * Theme.space-3;
            height: parent.height - 2 * Theme.space-2;
            color: Theme.text;
            font-size: Theme.font-base;
            single-line: false;
            wrap: word-wrap;
            selection-background-color: Theme.primary.with-alpha(0.3);
            accessible-label: root.label;
        }
    }
}

// Labeled dropdown. Opens a scrollable option list over the screen.
export component Select inherits VerticalLayout {
    in property <string> label;
    in property <[string]> options;
    in-out property <int> selected;
    in property <bool> invalid;
    callback changed(int);
    spacing: Theme.space-1;
    if root.label != "": FieldLabel { text: root.label; }
    field := Rectangle {
        height: Theme.tap;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: root.invalid ? Theme.danger : Theme.border;
        background: Theme.surface;
        accessible-role: combobox;
        accessible-label: root.label;
        accessible-value: root.options[root.selected];
        HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-2;
            Text {
                text: root.options[root.selected];
                color: Theme.text;
                font-size: Theme.font-base;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Icon {
                y: (parent.height - self.height) / 2;
                icon: Icons.chevron-down;
                color: Theme.text-muted;
                width: 18px;
                height: 18px;
            }
        }
        TouchArea {
            clicked => { popup.show(); }
        }
        popup := PopupWindow {
            x: 0;
            y: field.height + 2px;
            width: field.width;
            height: min(root.options.length * Theme.tap + 2px, 300px);
            close-policy: close-on-click;
            Rectangle {
                background: Theme.surface-raised;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: Theme.radius-sm;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000040;
                clip: true;
                Flickable {
                    content-height: root.options.length * Theme.tap;
                    VerticalLayout {
                        for option[i] in root.options: Rectangle {
                            height: Theme.tap;
                            background: i == root.selected ? Theme.primary.with-alpha(0.15) : option-touch.pressed ? Theme.bg : transparent;
                            Text {
                                x: Theme.space-3;
                                width: parent.width - 2 * Theme.space-3;
                                text: option;
                                color: Theme.text;
                                font-size: Theme.font-base;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            option-touch := TouchArea {
                                clicked => {
                                    root.selected = i;
                                    root.changed(i);
                                    popup.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}


// A centered icon + message shown when a list has nothing to show.
export component EmptyState inherits VerticalLayout {
    in property <string> message;
    in property <string> icon;
    padding: Theme.space-5;
    spacing: Theme.space-2;
    alignment: center;
    HorizontalLayout {
        alignment: center;
        Icon {
            icon: root.icon;
            color: Theme.text-muted;
            width: 32px;
            height: 32px;
        }
    }
    Text {
        text: root.message;
        color: Theme.text-muted;
        font-size: Theme.font-base;
        horizontal-alignment: center;
    }
}

// Small rounded label, like the web app's .badge.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> overdue;
    in property <bool> accent;
    height: 22px;
    width: label.preferred-width + 2 * Theme.space-2;
    border-radius: 11px;
    background: overdue ? Theme.overdue-bg : accent ? Theme.primary-soft : Theme.badge-bg;
    label := Text {
        text: root.text;
        font-size: 12px;
        font-weight: 500;
        color: root.overdue ? Theme.overdue-text : accent ? Theme.primary : Theme.text-muted;
        vertical-alignment: center;
    }
}

// Square check box; the whole control is the tap target.
export component Checkbox inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled();
    width: Theme.tap;
    height: Theme.tap;
    accessible-role: checkbox;
    accessible-label: label;
    accessible-checked: checked;
    accessible-action-default => { touch.clicked(); }
    Rectangle {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        border-width: root.checked ? 0px : 2px;
        border-color: Theme.text-muted;
        background: root.checked ? Theme.primary : transparent;
        if root.checked: Icon {
            icon: Icons.check;
            color: Theme.primary-text;
            width: 18px;
            height: 18px;
        }
    }
    touch := TouchArea {
        clicked => { root.toggled(); }
    }
}

// A label with an on/off switch; tapping anywhere on the row flips it.
export component ToggleRow inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback changed(bool);
    min-height: Theme.tap;
    accessible-role: switch;
    accessible-label: text;
    accessible-checked: checked;
    accessible-action-default => { touch.clicked(); }
    HorizontalLayout {
        spacing: Theme.space-3;
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-base;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 46px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: root.checked ? Theme.primary : Theme.border;
            animate background { duration: 120ms; }
            Rectangle {
                width: 22px;
                height: 22px;
                y: 3px;
                x: root.checked ? parent.width - self.width - 3px : 3px;
                border-radius: 11px;
                background: #ffffff;
                drop-shadow-blur: 2px;
                drop-shadow-color: #00000040;
                animate x { duration: 120ms; easing: ease; }
            }
        }
    }
    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.changed(root.checked);
        }
    }
}
