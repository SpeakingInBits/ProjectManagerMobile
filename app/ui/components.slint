// Composite widgets shared by several screens.

import { DatePickerPopup } from "std-widgets.slint";
import { Theme, Icons, Icon, IconBtn, Badge, Checkbox, FieldLabel } from "theme.slint";
import { App, Date, ProjectCardData, TaskRowData, TimeItemData, SummaryData } from "state.slint";

export component ProgressBar inherits Rectangle {
    in property <float> fill;
    height: 8px;
    border-radius: 4px;
    background: Theme.border;
    clip: true;
    accessible-role: progress-indicator;
    accessible-value: round(clamp(root.fill, 0, 1) * 100) + "%";
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.fill, 0, 1);
        height: 100%;
        border-radius: 4px;
        background: root.fill >= 1 ? Theme.success : Theme.primary;
        animate width { duration: 200ms; easing: ease; }
    }
}

export component ProjectCard inherits Rectangle {
    in property <ProjectCardData> data;
    background: touch.pressed ? Theme.bg : Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-md;
    accessible-role: button;
    accessible-label: data.title;
    accessible-description: data.progress-label;
    accessible-action-default => { touch.clicked(); }
    // Below the move buttons so they get their own taps.
    touch := TouchArea {
        clicked => { App.open-project(root.data.id); }
    }
    VerticalLayout {
        padding: Theme.space-3;
        padding-left: Theme.space-4;
        spacing: Theme.space-2;
        HorizontalLayout {
            Text {
                text: root.data.title;
                color: Theme.text;
                font-size: Theme.font-md;
                font-weight: 600;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            IconBtn {
                icon: Icons.arrow-up;
                label: "Move up";
                enabled: root.data.can-up;
                clicked => { App.move-project(root.data.id, true); }
            }
            IconBtn {
                icon: Icons.arrow-down;
                label: "Move down";
                enabled: root.data.can-down;
                clicked => { App.move-project(root.data.id, false); }
            }
        }
        if root.data.description != "": Text {
            text: root.data.description;
            color: Theme.text-muted;
            font-size: Theme.font-sm + 1px;
            wrap: word-wrap;
        }
        if root.data.due-label != "": HorizontalLayout {
            alignment: start;
            Badge {
                text: root.data.due-label;
                overdue: root.data.overdue;
            }
        }
        ProgressBar { fill: root.data.fill; }
        Text {
            text: root.data.progress-label;
            color: Theme.text-muted;
            font-size: Theme.font-sm;
        }
    }
}

export component TaskRow inherits Rectangle {
    in property <TaskRowData> data;
    property <bool> pinned: !data.completed && data.pinned;
    background: pinned ? Theme.primary-soft : Theme.surface;
    border-color: pinned ? Theme.primary : Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-md;
    HorizontalLayout {
        padding: Theme.space-1;
        padding-right: 0px;
        spacing: 0px;
        Checkbox {
            y: (parent.height - self.height) / 2;
            checked: root.data.completed;
            label: root.data.completed ? "Mark not completed" : "Mark completed";
            toggled => { App.toggle-task(root.data.id); }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            spacing: Theme.space-1;
            HorizontalLayout {
                spacing: Theme.space-1;
                if root.pinned: Icon {
                    y: 2px;
                    icon: Icons.pin;
                    color: Theme.primary;
                    width: 16px;
                    height: 16px;
                }
                Text {
                    text: root.data.title;
                    color: root.data.completed ? Theme.text-muted : Theme.text;
                    font-size: Theme.font-base;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    accessible-role: text;
                }
            }
            // On its own line so a long project name elides instead of widening the row.
            if root.data.project-label != "": Text {
                text: root.data.project-label;
                color: Theme.primary;
                font-size: Theme.font-sm;
                font-weight: 500;
                overflow: elide;
                min-width: 0px;
            }
            if root.data.due-label != "" || root.data.repeats: HorizontalLayout {
                spacing: Theme.space-1;
                alignment: start;
                if root.data.due-label != "": Badge {
                    text: root.data.due-label;
                    overdue: root.data.overdue;
                }
                if root.data.repeats: Badge { text: "Repeats"; }
            }
        }
        if !root.data.completed: IconBtn {
            y: (parent.height - self.height) / 2;
            icon: Icons.pin;
            label: root.data.pinned ? "Unpin task" : "Pin task to top";
            icon-color: root.data.pinned ? Theme.primary : Theme.text-muted;
            clicked => { App.pin-task(root.data.id); }
        }
        IconBtn {
            y: (parent.height - self.height) / 2;
            icon: Icons.edit;
            label: "Edit task";
            clicked => { App.edit-task(root.data.id); }
        }
        IconBtn {
            y: (parent.height - self.height) / 2;
            icon: Icons.trash;
            label: "Delete task";
            clicked => { App.delete-task(root.data.id); }
        }
    }
}

// Label above a value, like the web app's .time-summary.
export component SummaryTile inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> large;
    horizontal-stretch: 1;
    preferred-width: 60px;
    min-width: 0px;
    spacing: 0px;
    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.font-sm;
        overflow: elide;
    }
    Text {
        text: root.value;
        color: Theme.text;
        font-size: root.large ? Theme.font-lg : Theme.font-base;
        font-weight: 700;
        overflow: elide;
    }
}

// Day / week / month totals for one group of items.
export component SummaryCard inherits Rectangle {
    in property <SummaryData> data;
    in property <bool> large;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-md;
    VerticalLayout {
        padding: Theme.space-3;
        padding-left: Theme.space-4;
        spacing: Theme.space-2;
        Text {
            text: root.data.name;
            color: Theme.text;
            font-size: Theme.font-base;
            font-weight: 600;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: Theme.space-3;
            SummaryTile {
                label: App.time-day-label;
                value: root.data.day;
                large: root.large;
            }
            SummaryTile {
                label: root.large ? "This week" : "Week";
                value: root.data.week;
                large: root.large;
            }
            SummaryTile {
                label: root.large ? "This month" : "Month";
                value: root.data.month;
                large: root.large;
            }
        }
    }
}

component StepButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background: touch.pressed ? Theme.primary.darker(0.15) : Theme.primary;
    opacity: enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { touch.clicked(); }
    Icon {
        icon: root.icon;
        color: Theme.primary-text;
        width: 24px;
        height: 24px;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Text-only button, for secondary actions inside a card.
export component LinkBtn inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked();
    height: Theme.tap;
    width: label.preferred-width + 2 * Theme.space-3;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { touch.clicked(); }
    label := Text {
        text: root.text;
        color: root.danger ? Theme.danger : Theme.primary;
        font-size: Theme.font-sm + 1px;
        font-weight: 600;
        opacity: touch.pressed ? 0.6 : 1;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component TimeItemCard inherits Rectangle {
    in property <TimeItemData> data;
    background: data.worked ? Theme.primary-soft : Theme.surface;
    border-color: data.worked ? Theme.primary-soft-border : Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-md;
    VerticalLayout {
        padding: Theme.space-3;
        padding-left: Theme.space-4;
        spacing: Theme.space-2;
        HorizontalLayout {
            spacing: 0px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.data.title;
                    color: Theme.text;
                    font-size: Theme.font-base;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if root.data.category != "": HorizontalLayout {
                    alignment: start;
                    Badge { text: root.data.category; }
                }
                if root.data.description != "": Text {
                    text: root.data.description;
                    color: Theme.text-muted;
                    font-size: Theme.font-sm;
                    wrap: word-wrap;
                }
            }
            IconBtn {
                icon: Icons.history;
                label: "History";
                clicked => { App.open-history(root.data.id); }
            }
            IconBtn {
                icon: Icons.edit;
                label: "Edit item";
                clicked => { App.edit-time-item(root.data.id); }
            }
            IconBtn {
                icon: Icons.trash;
                label: "Delete item";
                clicked => { App.delete-time-item(root.data.id); }
            }
        }

        // − total + stepper, logging to the entry date.
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: center;
            StepButton {
                icon: Icons.minus;
                label: "Subtract 15 minutes from " + App.time-day-label;
                enabled: root.data.can-subtract;
                clicked => { App.step-time(root.data.id, false); }
            }
            Text {
                text: root.data.total;
                min-width: 110px;
                color: Theme.text;
                font-size: 26px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: text;
                accessible-label: "Total time worked";
                accessible-value: root.data.total;
            }
            StepButton {
                icon: Icons.plus;
                label: "Add 15 minutes to " + App.time-day-label;
                clicked => { App.step-time(root.data.id, true); }
            }
        }

        Rectangle {
            border-radius: Theme.radius-sm;
            background: Theme.bg;
            VerticalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-1;
                padding-bottom: root.data.note != "" ? Theme.space-2 : 0px;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text {
                        text: App.time-day-label;
                        color: Theme.text-muted;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.data.day-value;
                        color: Theme.text;
                        font-size: Theme.font-base;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.data.worked: LinkBtn {
                        text: root.data.note != "" ? "Edit note" : "Add note";
                        clicked => { App.edit-note(root.data.id); }
                    }
                    if !root.data.worked: Rectangle { height: Theme.tap; }
                }
                if root.data.note != "": Text {
                    text: root.data.note;
                    color: Theme.text;
                    font-size: Theme.font-sm;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-3;
            SummaryTile { label: "This week"; value: root.data.week; }
            SummaryTile { label: "This month"; value: root.data.month; }
            SummaryTile { label: "Total"; value: root.data.total; }
        }
    }
}

// Tappable date field backed by the platform-neutral date picker popup.
export component DateField inherits VerticalLayout {
    in property <string> label;
    in-out property <Date> date;
    // Optional dates can be cleared; `has-value` false shows "Not set".
    in property <bool> optional;
    in-out property <bool> has-value: true;
    spacing: Theme.space-1;
    FieldLabel { text: root.label; }
    field := Rectangle {
        height: Theme.tap;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        accessible-role: button;
        accessible-label: root.label;
        accessible-value: root.has-value ? App.format-date(root.date) : "Not set";
        HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-1;
            spacing: Theme.space-2;
            Text {
                text: root.has-value ? App.format-date(root.date) : "Not set";
                color: root.has-value ? Theme.text : Theme.text-muted;
                font-size: Theme.font-base;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.optional && root.has-value: IconBtn {
                icon: Icons.close;
                label: "Clear " + root.label;
                width: 36px;
                clicked => { root.has-value = false; }
            }
            Icon {
                y: (parent.height - self.height) / 2;
                icon: Icons.calendar;
                color: Theme.text-muted;
                width: 18px;
                height: 18px;
            }
            Rectangle { width: Theme.space-2; }
        }
        TouchArea {
            // Leave the clear button tappable.
            width: root.optional && root.has-value ? parent.width - 72px : parent.width;
            x: 0;
            clicked => { picker.show(); }
        }
        picker := DatePickerPopup {
            x: (App.window-width - self.width) / 2 - field.absolute-position.x;
            y: max(0px, (App.window-height - self.height) / 2) - field.absolute-position.y;
            title: root.label;
            date: root.has-value ? root.date : App.today;
            accepted(d) => {
                root.date = d;
                root.has-value = true;
                self.close();
            }
            canceled => { self.close(); }
        }
    }
}
